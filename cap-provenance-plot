    "pair_mass_sharedparton_mpi",
    "dphi_pair_MPI_SameMPI", "dphi_pair_MPI_CrossMPI",
    "dphi_pair_SharedParton_SameMPI",
    # 10. shower lineage
    "pair_dphi_shower", "pair_deta_shower", "pair_mass_shower",
    # 11. heavy flavour
    "pair_dphi_hf", "pair_deta_hf", "pair_mass_hf",
    "pair_decay_depth_pairclass",
    "pt_HF_FromBottomChain", "pt_HF_FromCharmChain",
    # 12. event-activity bins (multiplicity, then shape)
    "pair_dphi_lowmult", "pair_dphi_midmult", "pair_dphi_highmult",
    "pair_deta_lowmult", "pair_deta_midmult", "pair_deta_highmult",
    "pair_dphi_jetlike", "pair_dphi_midshape", "pair_dphi_isotropic",
    "pair_deta_jetlike", "pair_deta_midshape", "pair_deta_isotropic",
    # 13. fragmentation systems (string / cluster anatomy)
    "frag_nsystems", "frag_nhad_per_system",
    "frag_system_mass", "frag_system_mass_zoom", "frag_nhad_vs_mass",
    "frag_y_span", "frag_lambda",
    "frag_charge_ordering", "frag_neighbor_charge", "frag_neighbor_ptbal",
    "frag_bbar", "frag_bbar_dy_same", "frag_strange",
    "frag_cluster_mass_top", "frag_cluster_mass_decaying",
    "frag_cluster_fission",
    # 14. entropy / information block (own report section)
    "entropy_mult", "entropy_kno", "entropy_fb", "entropy_fb_mi_gap",
    "entropy_nmpi", "entropy_stage_S", "entropy_stage_meanN",
    "entropy_stage_total",
    "ent_mult_eta05", "ent_mult_full", "ent_fb_mi_gap",
    "ent_stage_S", "ent_stage_meanN", "ent_stage_total",
]
_ORDER_INDEX = {s: i for i, s in enumerate(REPORT_ORDER)}
_SUFFIX_RE = re.compile(r"_S\d+(?:x\d+)?$")


def _order_key(stem):
    """Canonical sort index of one figure stem (prefix/suffix-insensitive)."""
    for pre in ("compare_", "ladder_"):
        if stem.startswith(pre):
            stem = stem[len(pre):]
            break
    stem = _SUFFIX_RE.sub("", stem)
    return _ORDER_INDEX.get(stem, len(REPORT_ORDER))


def sort_manifest(manifest):
    """Stable-sort the (fname, caption) manifest into REPORT_ORDER."""
    return sorted(manifest,
                  key=lambda fc: _order_key(os.path.splitext(fc[0])[0]))


def main():
    ap = argparse.ArgumentParser(
        description="Overlay plots for provenance-study / mechanism-ladder "
                    "output.")
    ap.add_argument("--root", metavar="FILE",
                    help="a single provenance-study .root file")
    ap.add_argument("--ladder", metavar="DIR",
                    help="a cap-mechanism-ladder output directory")
    ap.add_argument("--compare", metavar="DIR",
                    help="a generator-comparison directory holding one "
                         "<generator>.root each (overlays Pythia vs Herwig ...)")
    ap.add_argument("--outdir",
                    default=os.path.join(REPO, "provenance", "plots"),
                    help="directory for the figures (default provenance/plots/)")
    ap.add_argument("--format", default="pdf", choices=["pdf", "png", "svg"],
                    help="figure file format (default pdf)")
    ap.add_argument("--normalize", action="store_true",
                    help="normalize every histogram to unit integral")
    ap.add_argument("--species", metavar="LIST",
                    help="comma-separated |pdg| to restrict single-particle "
                         "figures to (multi-species files only; default all)")
    ap.add_argument("--pairs", metavar="LIST",
                    help="comma-separated species-pairs a x b to restrict pair "
                         "figures to, e.g. 211x321,211x2212 (default all)")
    args = ap.parse_args()

    species_filter = None
    if args.species:
        species_filter = [int(t) for t in args.species.replace(" ", "").split(",")
                          if t]
    pairs_filter = None
    if args.pairs:
        pairs_filter = []
        for tok in args.pairs.replace(" ", "").split(","):
            if not tok:
                continue
            if "x" not in tok:
                sys.exit("bad --pairs token '%s' (expected <a>x<b>)" % tok)
            a, b = tok.split("x", 1)
            pairs_filter.append((int(a), int(b)))

    if not args.root and not args.ladder and not args.compare:
        ap.error("give --root FILE and/or --ladder DIR and/or --compare DIR")

    os.makedirs(args.outdir, exist_ok=True)
    manifest = []   # (filename, caption)

    print("cap-provenance-plot — figures -> %s" % args.outdir)

    # ---- single-run decomposition figures -------------------------------
    if args.root:
        if not os.path.exists(args.root):
            sys.exit("ROOT file not found: " + args.root)
        print("single run: %s" % args.root)
        emit_single_run(args.root, args.outdir, args.format,
                        args.normalize, manifest,
                        species_filter=species_filter,
                        pairs_filter=pairs_filter)

    # ---- mechanism-ladder comparison figures ----------------------------
    if args.ladder:
        if not os.path.isdir(args.ladder):
            sys.exit("ladder directory not found: " + args.ladder)
        rungs = discover_rungs(args.ladder)
        if not rungs:
            sys.exit("no rung .root files found in " + args.ladder)
        print("ladder: %d rung(s) — %s"
              % (len(rungs), ", ".join(r[0] for r in rungs)))
        for histname, xtitle, logy, caption in LADDER_HISTS:
            out = os.path.join(args.outdir, "ladder_" + histname + "."
                               + args.format)
            cap = overlay_ladder(rungs, histname, xtitle, out, caption,
                                 logy=logy, normalize=True)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- generator comparison (Pythia vs Herwig vs ...) -----------------
    if args.compare:
        if not os.path.isdir(args.compare):
            sys.exit("comparison directory not found: " + args.compare)
        gens = discover_generators(args.compare)
        if not gens:
            sys.exit("no <generator>.root files found in " + args.compare)
        labels  = [g[0] for g in gens]
        paths   = [(g[0], g[1]) for g in gens]
        colours = [g[2] for g in gens]
        print("generator comparison: %d generator(s) — %s"
              % (len(gens), ", ".join(labels)))
        # Use the CURATED COMPARE_HISTS set: every figure is an overlay of the
        # same observable across the generators, restricted to observables BOTH
        # populate (so no figure is silently single-generator).
        for histname, xtitle, logy, caption in COMPARE_HISTS:
            out = os.path.join(args.outdir, "compare_" + histname + "."
                               + args.format)
            cap = overlay_ladder(paths, histname, xtitle, out, caption,
                                 logy=logy, normalize=True, colours=colours,
                                 context_label="generators", require_all=True)
            if cap:
                manifest.append((os.path.basename(out), cap))
        # Fragmentation-system comparison (only when EVERY generator ran
        # with --systems).
        for histname, xtitle, logy, caption in COMPARE_FRAG_HISTS:
            out = os.path.join(args.outdir, "compare_" + histname + "."
                               + args.format)
            cap = overlay_ladder(paths, histname, xtitle, out, caption,
                                 logy=logy, normalize=True, colours=colours,
                                 context_label="generators", require_all=True)
            if cap:
                manifest.append((os.path.basename(out), cap))
        # Entropy comparison (only when EVERY generator ran with --entropy,
        # so no figure is silently single-generator).
        for histname, xtitle, logy, caption in COMPARE_ENTROPY_HISTS:
            out = os.path.join(args.outdir, "compare_" + histname + "."
                               + args.format)
            cap = overlay_ladder(paths, histname, xtitle, out, caption,
                                 logy=logy, normalize=True, colours=colours,
                                 context_label="generators", require_all=True)
            if cap:
                manifest.append((os.path.basename(out), cap))
        for hist, ytitle, caption in ENT_STAGE_HISTS:
            out = os.path.join(args.outdir, "compare_" + hist + "."
                               + args.format)
            cap = overlay_stage_profile(paths, hist, ytitle, out,
                                        caption + "  Overlaid per generator; "
                                        "NOT normalized (these are entropy / "
                                        "count values, not distributions).",
                                        colours=colours, require_all=True)
            if cap:
                manifest.append((os.path.basename(out), cap))
        out = os.path.join(args.outdir, "compare_ent_fb_mi_gap."
                           + args.format)
        cap = overlay_stage_profile(
            paths, "ent_fb_mi_gap", "I(N_{F};N_{B}) [bits]", out,
            "Forward-backward mutual information vs eta gap, per generator "
            "(NOT normalized).  How fast each hadronization model loses "
            "shared information with rapidity separation -- a direct "
            "string-vs-cluster discriminant.",
            colours=colours, require_all=True,
            bin_labels=None, xtitle="#eta gap")
        if cap:
            manifest.append((os.path.basename(out), cap))

    # ---- manifest for the report-builder --------------------------------
    # Sorted into the canonical topical order (REPORT_ORDER) so the report
    # reads coherently: related plots adjacent, each raw plot immediately
    # followed by its normalized / fraction variant.
    manifest = sort_manifest(manifest)
    man_path = os.path.join(args.outdir, "figures.manifest")
    with open(man_path, "w") as fh:
        for fname, caption in manifest:
            fh.write("%s | %s\n" % (fname, caption))
    print("\nwrote %d figure(s); manifest -> %s" % (len(manifest), man_path))


if __name__ == "__main__":
    main()
