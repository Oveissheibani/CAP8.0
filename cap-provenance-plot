def emit_kno_figure(root_path, outdir, fmt, manifest):
    """KNO-scaling check: <N> P(N) vs N/<N> for every eta window, overlaid.
    KNO scaling (curve collapse) is exactly what makes S - ln<N> a universal
    constant, i.e. the structural reason behind the Kharzeev-Levin ratio."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)
    f = ROOT.TFile.Open(root_path)
    if not f or f.IsZombie():
        return
    graphs = []
    for base, label, colexpr in ENT_MULT_SERIES:
        h = f.Get("ent_" + base)
        if not h:
            continue
        tot = h.Integral()
        if tot <= 0:
            continue
        mean = h.GetMean()
        if mean <= 0:
            continue
        g = ROOT.TGraph()
        for b in range(1, h.GetNbinsX() + 1):
            c = h.GetBinContent(b)
            if c <= 0:
                continue
            n = h.GetBinCenter(b) - 0.5          # filled at N + 0.5
            g.SetPoint(g.GetN(), n / mean, mean * (c / tot))
        if g.GetN() < 3:
            continue
        col = root_color(colexpr, ROOT)
        g.SetMarkerColor(col); g.SetLineColor(col)
        g.SetMarkerStyle(MARKER_STYLE); g.SetMarkerSize(MARKER_SIZE)
        graphs.append((g, label))
    f.Close()
    if not graphs:
        print("  ! entropy_kno: no multiplicity histograms (entropy off?)")
        return
    out = os.path.join(outdir, "entropy_kno." + fmt)
    canvas = ROOT.TCanvas("ck_kno", "", 900, 680)
    canvas.SetLogy()
    mg = ROOT.TMultiGraph()
    for g, _ in graphs:
        mg.Add(g, "P")
    mg.SetTitle(";N / #LTN#GT;#LTN#GT P(N)")
    mg.Draw("A")
    legend = ROOT.TLegend(0.62, 0.65, 0.88, 0.88)
    _legend_style(legend, ROOT)
    for g, label in graphs:
        legend.AddEntry(g, label, "p")
    legend.Draw()
    canvas.SaveAs(out)
    print("  wrote %s" % out)
    caption = ("KNO-scaling check: the multiplicity distributions of every "
               "pseudorapidity window, rescaled to <N> P(N) vs N/<N>.  If "
               "the curves collapse onto one shape (KNO scaling holds), the "
               "entropy obeys S = ln<N> + const -- the structural origin of "
               "the Kharzeev-Levin ratio reported in the entropy table.")
    manifest.append((os.path.basename(out), caption))


