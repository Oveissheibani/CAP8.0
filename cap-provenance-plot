def overlay_ladder(rung_files, histname, xtitle, out_path, caption,
                   logy=False, normalize=True, colours=None,
                   context_label="the mechanism ladder", require_all=False):
    """Overlay one histogram across a set of ROOT files (one per rung /
    generator) in the standardized plot style.

    colours        — optional list of ROOT colour expressions, one per rung
                     (used for generator comparison so each generator keeps a
                     fixed colour); falls back to LADDER_COLOURS by index.
    context_label  — what the overlay spans, for the plot title (e.g. 'the
                     mechanism ladder' or 'generators').
    require_all    — if True, the figure is emitted ONLY when EVERY input file
                     has the histogram with entries; if any input lacks it or
                     it is empty, the whole figure is skipped (returns None).
                     Used by generator comparison so no figure is ever drawn
                     with only one generator's curve — the quantitative zero
                     lives in the tables instead.  When a structurally-empty
                     observable later fills (e.g. Herwig primaries after the
                     cluster-labelling fix), the figure reappears automatically."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    palette = colours if colours else LADDER_COLOURS

    prepared = []
    n_inputs = len(rung_files)
    n_usable = 0
    for i, (label, path) in enumerate(rung_files):
        f = ROOT.TFile.Open(path)
        if not f or f.IsZombie():
            print("  ! cannot open rung file %s" % path)
            continue
        h = f.Get(histname)
        if not h:
            print("  ! %s: histogram '%s' not found" % (path, histname))
            f.Close()
            continue
        h = h.Clone("%s_rung%d" % (histname, i))
        h.SetDirectory(0)
        f.Close()
        integral = h.Integral()
        if integral > 0:
            n_usable += 1
        # Honestly flag an empty series so a comparison figure never looks
        # single-generator by accident — an all-zero curve is invisible
        # after normalization, so we say so in the legend.
        if integral <= 0:
            label = label + " (no entries)"
        if normalize and integral > 0:
            h.Scale(1.0 / integral)
        _style_marker(h, root_color(palette[i % len(palette)], ROOT))
        prepared.append((h, label))

    # Strict comparison: every input must contribute real entries, else skip
    # so the figure is never single-generator.
    if require_all and n_usable < n_inputs:
        print("  · skip %s: only %d/%d inputs have entries (comparison "
              "needs all)" % (histname, n_usable, n_inputs))
        return None

    if not prepared:
        print("  ! %s: no input produced histogram '%s'"
              % (context_label, histname))
        return None

    canvas = ROOT.TCanvas("cl_" + os.path.basename(out_path), histname, 900, 680)
    if logy: canvas.SetLogy()
    ymin, ymax = _yrange([p[0] for p in prepared], logy)
    prepared[0][0].SetMinimum(ymin)
    prepared[0][0].SetMaximum(ymax)
    _style_axes(prepared[0][0], xtitle,
                "normalized" if normalize else "counts",
                histname + " across " + context_label)

    legend = ROOT.TLegend(0.62, 0.65, 0.88, 0.88)
    _legend_style(legend, ROOT)
    for i, (h, label) in enumerate(prepared):
        h.Draw("PE" if i == 0 else "PE SAME")
        legend.AddEntry(h, label, "pe")
    legend.Draw()

    canvas.SaveAs(out_path)
    print("  wrote %s" % out_path)
    return caption


def discover_rungs(ladder_dir):
    """Return [(rung-label, root-path), ...] in ladder order.

    Prefers the column order in ladder-comparison.csv; falls back to a
    sorted glob of *.root in the directory."""
    csv_path = os.path.join(ladder_dir, "ladder-comparison.csv")
    rungs = []
    if os.path.exists(csv_path):
        with open(csv_path) as fh:
            header = next(csv.reader(fh))
        # header: group, observable, <rung1>, <rung2>, ...
        for name in header[2:]:
            tag = name.replace("+", "_").replace(" ", "_")
            path = os.path.join(ladder_dir, tag + ".root")
            if os.path.exists(path):
                rungs.append((name, path))
    if not rungs:
        for path in sorted(glob.glob(os.path.join(ladder_dir, "*.root"))):
            label = os.path.splitext(os.path.basename(path))[0]
            rungs.append((label, path))
    return rungs


# --- generator comparison (Pythia vs Herwig vs ...) --------------------------
# A comparison directory holds one <generator>.root per generator.  We give
# each generator a pretty legend label and a FIXED colour so the same generator
# is always the same colour across every figure.
GENERATOR_LABELS = {
    "pythia": "Pythia 8", "herwig": "Herwig 7",
    "sherpa": "Sherpa", "epos": "EPOS",
}
GENERATOR_COLOURS = {
    "pythia": "kAzure+1", "herwig": "kRed+1",
    "sherpa": "kGreen+2", "epos": "kOrange+7",
}
GENERATOR_ORDER = ["pythia", "herwig", "sherpa", "epos"]


def discover_generators(compare_dir):
    """Return [(pretty-label, root-path, colour-expr), ...] for the .root files
    in a comparison directory.

    Two naming schemes are understood:
      <generator>.root           → "Pythia 8"        (plain generator compare)
      <generator>_<rung>.root    → "Pythia 8 · +MPI" (cross-generator mechanism
                                    comparison; coloured by generator so the
                                    same generator's rungs share a colour)
    Ordered by GENERATOR_ORDER, then rung name.
    """
    items = []                                   # (gen, rung|None, path)
    for path in glob.glob(os.path.join(compare_dir, "*.root")):
        stem = os.path.splitext(os.path.basename(path))[0]
        low = stem.lower()
        gen, rung = low, None
        if low not in GENERATOR_LABELS and "_" in stem:
            pre, suf = stem.split("_", 1)
            if pre.lower() in GENERATOR_LABELS:
                gen, rung = pre.lower(), suf
        items.append((gen, rung, path))

    def _key(it):
        gi = GENERATOR_ORDER.index(it[0]) if it[0] in GENERATOR_ORDER else 99
        return (gi, it[1] or "")
    items.sort(key=_key)

    out = []
    for i, (gen, rung, path) in enumerate(items):
        glabel = GENERATOR_LABELS.get(gen, gen.capitalize())
        label = glabel if rung is None else "%s · %s" % (glabel, rung)
        colour = GENERATOR_COLOURS.get(gen, LADDER_COLOURS[i % len(LADDER_COLOURS)])
        out.append((label, path, colour))
    return out


# --- multi-species support ---------------------------------------------------
# provenance-study --species 211,321,2212 emits per-species single-particle
# histograms suffixed _S<pdg> and per-species-pair pair histograms suffixed
# _S<a>x<b>.  Single-species runs keep the legacy bare names untouched.

# Classify the SINGLE_FIGURES entries by which suffix axis (if any) the engine
# attaches to their underlying histogram:
#   per-species  (_S<pdg>)   : ProvenanceObservables single-particle fills
#   per-pair     (_S<a>x<b>)  : PairProvenanceObservables per-pair fill
#   global       (no suffix)  : event-level histograms, filled once per event
SINGLE_FIGURES_PER_SPECIES = {"n_parton_ancestors", "decay_chain_depth"}
SINGLE_FIGURES_PER_PAIR    = {"common_ancestor_depth"}
SINGLE_FIGURES_GLOBAL      = {"event_multiplicity", "event_spherocity"}

# A few human-friendly species names; everything else falls back to the PDG.
# Used only for ROOT canvas/axis titles (TLatex), never for the manifest text.
SPECIES_NAMES = {
    211:  "#pi^{#pm}",
    321:  "K^{#pm}",
    2212: "p",
    2112: "n",
    310:  "K^{0}_{S}",
    3122: "#Lambda",
}


def species_tag(pdg):
    """TLatex label for one species, for plot titles."""
    return SPECIES_NAMES.get(pdg, "PDG %d" % pdg)


def discover_species(root_path):
    """Return the sorted list of |pdg| species present in this run.

    A list of length <= 1 (or empty) means single-species / legacy mode, in
    which case the caller should keep the historical bare-name behaviour.

    Preferred source is the `species_list=` token in the <root>.txt summary
    written by provenance-study; if that is absent we scan the ROOT keys for
    `_S<digits>` / `_S<a>x<b>` suffixes.
    """
    # 1) summary file (preferred — cheap, no ROOT needed)
    txt = root_path + ".txt"
    if os.path.exists(txt):
        try:
            with open(txt) as fh:
                for line in fh:
                    m = re.search(r"species_list=([0-9,]+)", line)
                    if m:
                        vals = [int(x) for x in m.group(1).split(",") if x]
                        return sorted(set(vals))
        except OSError:
            pass

    # 2) fall back to scanning the ROOT keys for the suffix patterns
    try:
        import ROOT
        ROOT.gROOT.SetBatch(True)
        f = ROOT.TFile.Open(root_path)
        if f and not f.IsZombie():
            found = set()
            for key in f.GetListOfKeys():
                for mm in re.finditer(r"_S(\d+)(?:x(\d+))?", key.GetName()):
                    found.add(int(mm.group(1)))
                    if mm.group(2):
                        found.add(int(mm.group(2)))
            f.Close()
            return sorted(found)
    except Exception:
        pass

    return []


def _suffixed_series(series, sfx):
    """Append the species suffix to every series base-name so that the
    histogram looked up becomes prefix + base + sfx (the engine appends the
    suffix to the END of the full histogram name)."""
    return [(base + sfx, label, col) for (base, label, col) in series]


def emit_single_run(root_path, outdir, fmt, normalize, manifest,
                    species_filter=None, pairs_filter=None):
    """Emit all single-run decomposition figures for one ROOT file.

    Detects the species axis: in single-species mode this reproduces the
    legacy bare-name figures exactly; in multi-species mode it emits each
    single-particle figure once per species (suffix _S<pdg>) and each pair
    figure once per species-pair (suffix _S<a>x<b>, N(N+1)/2 of them).

    Optional output filters (used by the GUI species/pair picker):
      species_filter : iterable of |pdg| to restrict the single-particle
                       figures to (subset of what's in the file).
      pairs_filter   : iterable of (a, b) |pdg| tuples to restrict the pair
                       figures to.  Each is canonicalised to a<=b.
    Both are *output* filters only — the engine still computed everything in
    the file.  When omitted, every species / pair present is emitted (the
    historical behaviour).  The naming convention (suffixed vs bare) is keyed
    on what the FILE actually contains, not on the filter, so filtering a
    multi-species file down to one species still uses the _S<pdg> names."""
    file_species = discover_species(root_path)
    multi = len(file_species) > 1

    if not multi:
        # -------- legacy single-species path (unchanged behaviour) --------
        for name, prefix, series, xtitle, logy, norm, caption in FIGURES:
            out = os.path.join(outdir, name + "." + fmt)
            cap = overlay(root_path, series, prefix, xtitle, out, caption,
                          logy=logy, normalize=(normalize or norm))
            if cap:
                manifest.append((os.path.basename(out), cap))
        for name, hist, xtitle, logy, caption in SINGLE_FIGURES:
            out = os.path.join(outdir, name + "." + fmt)
            cap = single_histogram(root_path, hist, xtitle, out, caption,
                                   logy=logy)
            if cap:
                manifest.append((os.path.basename(out), cap))
        for name, prefix, series, xtitle, divisor, caption in FRACTION_FIGURES:
            out = os.path.join(outdir, name + "." + fmt)
            cap = overlay_fractions(root_path, series, prefix, divisor,
                                    xtitle, out, caption)
            if cap:
                manifest.append((os.path.basename(out), cap))
        return

    # ------------------------- multi-species path -------------------------
    # Apply the optional output filters against what the file contains.
    species = list(file_species)
    if species_filter:
        keep = set(int(s) for s in species_filter)
        sel = [s for s in file_species if s in keep]
        if sel:
            species = sel

    # Build the ordered list of (a<=b) species-pairs to emit.
    if pairs_filter:
        want = set()
        for a, b in pairs_filter:
            a, b = int(a), int(b)
            want.add((min(a, b), max(a, b)))
        pair_list = [(a, b) for (a, b) in sorted(want)
                     if a in file_species and b in file_species]
    else:
        pair_list = []
        for ai in range(len(species)):
            for bi in range(ai, len(species)):
                pair_list.append((min(species[ai], species[bi]),
                                  max(species[ai], species[bi])))

    print("  multi-species mode: %s" % ", ".join(str(s) for s in file_species))
    if species_filter or pairs_filter:
        print("  filtered to species %s, %d pair(s)"
              % (",".join(str(s) for s in species), len(pair_list)))

    # ---- per-species single-particle figures (suffix _S<pdg>) ----
    for s in species:
        sfx   = "_S%d" % s
        note  = "  (species pdg = %d)" % s
        title = species_tag(s)
        for name, prefix, series, xtitle, logy, norm, caption in FIGURES:
            if name.startswith("pair"):
                continue
            out = os.path.join(outdir, name + sfx + "." + fmt)
            cap = overlay(root_path, _suffixed_series(series, sfx), prefix,
                          xtitle, out, caption + note,
                          logy=logy, normalize=(normalize or norm), title=title)
            if cap:
                manifest.append((os.path.basename(out), cap))
        for name, hist, xtitle, logy, caption in SINGLE_FIGURES:
            if name not in SINGLE_FIGURES_PER_SPECIES:
                continue
            out = os.path.join(outdir, name + sfx + "." + fmt)
            cap = single_histogram(root_path, hist + sfx, xtitle, out,
                                   caption + note, logy=logy)
            if cap:
                manifest.append((os.path.basename(out), cap))
        for name, prefix, series, xtitle, divisor, caption in FRACTION_FIGURES:
            if name.startswith("pair"):
                continue
            out = os.path.join(outdir, name + sfx + "." + fmt)
            cap = overlay_fractions(root_path, _suffixed_series(series, sfx),
                                    prefix, divisor + sfx, xtitle, out,
                                    caption + note)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- per-species-pair pair figures (suffix _S<a>x<b>, canonical a<=b) ----
    for p1, p2 in pair_list:
            sfx   = "_S%dx%d" % (p1, p2)
            note  = "  (species pdg = %d x %d)" % (p1, p2)
            title = "%s #times %s" % (species_tag(p1), species_tag(p2))
            for name, prefix, series, xtitle, logy, norm, caption in FIGURES:
                if not name.startswith("pair"):
                    continue
                out = os.path.join(outdir, name + sfx + "." + fmt)
                cap = overlay(root_path, _suffixed_series(series, sfx), prefix,
                              xtitle, out, caption + note,
                              logy=logy, normalize=(normalize or norm),
                              title=title)
                if cap:
                    manifest.append((os.path.basename(out), cap))
            for name, hist, xtitle, logy, caption in SINGLE_FIGURES:
                if name not in SINGLE_FIGURES_PER_PAIR:
                    continue
                out = os.path.join(outdir, name + sfx + "." + fmt)
                cap = single_histogram(root_path, hist + sfx, xtitle, out,
                                       caption + note, logy=logy)
                if cap:
                    manifest.append((os.path.basename(out), cap))
            for name, prefix, series, xtitle, divisor, caption in FRACTION_FIGURES:
                if not name.startswith("pair"):
                    continue
                out = os.path.join(outdir, name + sfx + "." + fmt)
                cap = overlay_fractions(root_path, _suffixed_series(series, sfx),
                                        prefix, divisor + sfx, xtitle, out,
                                        caption + note)
                if cap:
                    manifest.append((os.path.basename(out), cap))

    # ---- global single-histogram figures (no species axis) ----
    for name, hist, xtitle, logy, caption in SINGLE_FIGURES:
        if name not in SINGLE_FIGURES_GLOBAL:
            continue
        out = os.path.join(outdir, name + "." + fmt)
        cap = single_histogram(root_path, hist, xtitle, out, caption, logy=logy)
        if cap:
            manifest.append((os.path.basename(out), cap))


def main():
    ap = argparse.ArgumentParser(
        description="Overlay plots for provenance-study / mechanism-ladder "
                    "output.")
    ap.add_argument("--root", metavar="FILE",
                    help="a single provenance-study .root file")
    ap.add_argument("--ladder", metavar="DIR",
                    help="a cap-mechanism-ladder output directory")
    ap.add_argument("--compare", metavar="DIR",
                    help="a generator-comparison directory holding one "
                         "<generator>.root each (overlays Pythia vs Herwig ...)")
    ap.add_argument("--outdir",
                    default=os.path.join(REPO, "provenance", "plots"),
                    help="directory for the figures (default provenance/plots/)")
    ap.add_argument("--format", default="pdf", choices=["pdf", "png", "svg"],
                    help="figure file format (default pdf)")
    ap.add_argument("--normalize", action="store_true",
                    help="normalize every histogram to unit integral")
    ap.add_argument("--species", metavar="LIST",
                    help="comma-separated |pdg| to restrict single-particle "
                         "figures to (multi-species files only; default all)")
    ap.add_argument("--pairs", metavar="LIST",
                    help="comma-separated species-pairs a x b to restrict pair "
                         "figures to, e.g. 211x321,211x2212 (default all)")
    args = ap.parse_args()

    species_filter = None
    if args.species:
        species_filter = [int(t) for t in args.species.replace(" ", "").split(",")
                          if t]
    pairs_filter = None
    if args.pairs:
        pairs_filter = []
        for tok in args.pairs.replace(" ", "").split(","):
            if not tok:
                continue
            if "x" not in tok:
                sys.exit("bad --pairs token '%s' (expected <a>x<b>)" % tok)
            a, b = tok.split("x", 1)
            pairs_filter.append((int(a), int(b)))

    if not args.root and not args.ladder and not args.compare:
        ap.error("give --root FILE and/or --ladder DIR and/or --compare DIR")

    os.makedirs(args.outdir, exist_ok=True)
    manifest = []   # (filename, caption)

    print("cap-provenance-plot — figures -> %s" % args.outdir)

    # ---- single-run decomposition figures -------------------------------
    if args.root:
        if not os.path.exists(args.root):
            sys.exit("ROOT file not found: " + args.root)
        print("single run: %s" % args.root)
        emit_single_run(args.root, args.outdir, args.format,
                        args.normalize, manifest,
                        species_filter=species_filter,
                        pairs_filter=pairs_filter)

    # ---- mechanism-ladder comparison figures ----------------------------
    if args.ladder:
        if not os.path.isdir(args.ladder):
            sys.exit("ladder directory not found: " + args.ladder)
        rungs = discover_rungs(args.ladder)
        if not rungs:
            sys.exit("no rung .root files found in " + args.ladder)
        print("ladder: %d rung(s) — %s"
              % (len(rungs), ", ".join(r[0] for r in rungs)))
        for histname, xtitle, logy, caption in LADDER_HISTS:
            out = os.path.join(args.outdir, "ladder_" + histname + "."
                               + args.format)
            cap = overlay_ladder(rungs, histname, xtitle, out, caption,
                                 logy=logy, normalize=True)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- generator comparison (Pythia vs Herwig vs ...) -----------------
    if args.compare:
        if not os.path.isdir(args.compare):
            sys.exit("comparison directory not found: " + args.compare)
        gens = discover_generators(args.compare)
        if not gens:
            sys.exit("no <generator>.root files found in " + args.compare)
        labels  = [g[0] for g in gens]
        paths   = [(g[0], g[1]) for g in gens]
        colours = [g[2] for g in gens]
        print("generator comparison: %d generator(s) — %s"
              % (len(gens), ", ".join(labels)))
        # Use the CURATED COMPARE_HISTS set: every figure is an overlay of the
        # same observable across the generators, restricted to observables BOTH
        # populate (so no figure is silently single-generator).
        for histname, xtitle, logy, caption in COMPARE_HISTS:
            out = os.path.join(args.outdir, "compare_" + histname + "."
                               + args.format)
            cap = overlay_ladder(paths, histname, xtitle, out, caption,
                                 logy=logy, normalize=True, colours=colours,
                                 context_label="generators", require_all=True)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- manifest for the report-builder --------------------------------
    man_path = os.path.join(args.outdir, "figures.manifest")
    with open(man_path, "w") as fh:
        for fname, caption in manifest:
            fh.write("%s | %s\n" % (fname, caption))
    print("\nwrote %d figure(s); manifest -> %s" % (len(manifest), man_path))


if __name__ == "__main__":
    main()
