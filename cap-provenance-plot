def overlay_stage_profile(files, histname, ytitle, out_path, caption,
                          colours=None, require_all=False,
                          bin_labels="stages", xtitle=""):
    """Entropy value-profile: one VALUE per bin (entropy / mean count / MI),
    NEVER normalized (normalizing a value profile would destroy its
    meaning).  bin_labels="stages" labels the bins with the stage names;
    bin_labels=None keeps a numeric axis (then xtitle is used).  `files` is
    [(label, path), ...] — one entry plots a single run, several entries
    overlay generators/rungs.  Skips silently when the histogram is absent
    (entropy-off runs); with require_all=True the figure is dropped unless
    EVERY file has it (no silently single-generator comparison figures)."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    prepared = []
    for i, (label, path) in enumerate(files):
        f = ROOT.TFile.Open(path)
        if not f or f.IsZombie():
            print("  ! cannot open %s — skipping" % path)
            continue
        h = f.Get(histname)
        if not h:
            f.Close()
            if require_all:
                print("  ! %s missing in %s — dropping figure %s"
                      % (histname, path, os.path.basename(out_path)))
                return None
            continue
        h = h.Clone("%s_stage_%d" % (histname, i))
        h.SetDirectory(0)
        col = root_color((colours or LADDER_COLOURS)[i % len(colours or LADDER_COLOURS)], ROOT)
        _style_marker(h, col)
        h.SetLineWidth(2)
        prepared.append((h, label))
        f.Close()
    if not prepared:
        print("  ! %s: no input had '%s' (entropy off?) — skipped"
              % (os.path.basename(out_path), histname))
        return None

    canvas = ROOT.TCanvas("ce_" + os.path.basename(out_path), "", 900, 680)
    canvas.SetBottomMargin(0.18)
    ymin, ymax = _yrange([p[0] for p in prepared], logy=False)
    first = prepared[0][0]
    first.SetMinimum(min(0.0, ymin))
    first.SetMaximum(ymax)
    _style_axes(first, xtitle, ytitle)
    if bin_labels == "stages":
        ax = first.GetXaxis()
        for b in range(1, min(first.GetNbinsX(), len(ENT_STAGE_LABELS)) + 1):
            ax.SetBinLabel(b, ENT_STAGE_LABELS[b - 1])
        ax.LabelsOption("v")

    legend = ROOT.TLegend(0.16, 0.72, 0.46, 0.88)
    _legend_style(legend, ROOT)
    for i, (h, label) in enumerate(prepared):
        h.Draw("P HIST" if i == 0 else "P HIST SAME")
        legend.AddEntry(h, label, "p")
    if len(prepared) > 1:
        legend.Draw()

    canvas.SaveAs(out_path)
    print("  wrote %s" % out_path)
    return caption


def emit_nch_vs_nmpi(root_path, outdir, fmt, manifest):
    """Centrality-quality profile: mean N_ch(|eta|<1) per N_MPI, from the
    sum/count histogram pair written by ProvenanceObservables.  Shows how
    faithfully the multiplicity estimator tracks the model-truth activity.
    Pythia only (HepMC input has no MPI tags) — skips silently otherwise."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)
    f = ROOT.TFile.Open(root_path)
    if not f or f.IsZombie():
        return
    hs = f.Get("nmult_nch_vs_nmpi_sum")
    hn = f.Get("nmult_nch_vs_nmpi_n")
    if not hs or not hn:
        f.Close()
        return
    prof = hs.Clone("nmult_nch_vs_nmpi_mean")
    prof.SetDirectory(0)
    hn = hn.Clone("nmult_nch_vs_nmpi_n_c")     # detach BEFORE the file closes
    hn.SetDirectory(0)
    prof.Divide(hn)
    f.Close()
    # Degenerate (single occupied bin == Herwig/no-MPI input): not useful.
    occupied = sum(1 for b in range(1, prof.GetNbinsX() + 1)
                   if hn.GetBinContent(b) > 0)
    if occupied < 2:
        print("  ! nmult_nch_vs_nmpi: single N_MPI bin (no MPI tags) — skipped")
        return
    out = os.path.join(outdir, "nmult_nch_vs_nmpi." + fmt)
    canvas = ROOT.TCanvas("c_nchnmpi", "", 900, 680)
    _style_marker(prof, root_color("kAzure+1", ROOT))
    _style_axes(prof, "N_{MPI} (distinct scatters)",
                "#LT N_{ch} (|#eta|<1) #GT")
    prof.SetMinimum(0.0)
    prof.Draw("PE")
    canvas.SaveAs(out)
    print("  wrote %s" % out)
    caption = ("Mean central charged multiplicity vs the model-truth MPI "
               "count.  The closer to linear and the smaller the scatter, "
               "the better N_ch works as a centrality estimator; flattening "
               "at high N_MPI means saturation -- multiplicity stops "
               "resolving the activity.")
    manifest.append((os.path.basename(out), caption))
    return


