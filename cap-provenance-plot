def root_color(expr, ROOT):
    """Resolve a colour expression like 'kRed+1' against the ROOT module."""
    expr = expr.strip()
    for op in ("+", "-"):
        if op in expr:
            base, off = expr.split(op, 1)
            val = getattr(ROOT, base.strip())
            return val + int(off) if op == "+" else val - int(off)
    return getattr(ROOT, expr)


# Standardized plot style used by every overlay --------------------------
MARKER_STYLE = 20    # filled circle
MARKER_SIZE  = 0.7

def _legend_style(legend, ROOT):
    """Standardize legend appearance: thin border, opaque white fill,
    fixed text size.  Placed at top-right via the TLegend constructor."""
    legend.SetBorderSize(1)
    legend.SetFillStyle(1001)
    legend.SetFillColor(ROOT.kWhite)
    legend.SetTextSize(0.030)


def _yrange(hists, logy, pad=0.10):
    """Compute (ymin, ymax) covering every histogram with padding so the
    curves never stick to the frame.

      linear y :  [ymin - pad*range, ymax + pad*range]
      log y    :  [smallest-positive / 2 ,  ymax * 2]
    """
    if logy:
        ymin = float("inf")
        ymax = 0.0
        for h in hists:
            for b in range(1, h.GetNbinsX() + 1):
                v = h.GetBinContent(b)
                if v > 0.0 and v < ymin: ymin = v
                if v > ymax:             ymax = v
        if ymin == float("inf") or ymin <= 0.0: ymin = 0.1
        if ymax <= 0.0:                         ymax = 1.0
        return ymin * 0.5, ymax * 2.0
    ymin = min(h.GetMinimum() for h in hists)
    ymax = max(h.GetMaximum() for h in hists)
    rng = ymax - ymin
    if rng <= 0.0:
        rng = max(1.0, abs(ymax))
    return ymin - pad * rng, ymax + pad * rng


def _style_axes(hist, xtitle, ytitle, title=""):
    hist.GetXaxis().SetTitle(xtitle)
    hist.GetYaxis().SetTitle(ytitle)
    if title:
        hist.SetTitle(title)


def _style_marker(hist, col):
    hist.SetLineColor(col);   hist.SetLineWidth(1)
    hist.SetMarkerColor(col); hist.SetMarkerStyle(MARKER_STYLE)
    hist.SetMarkerSize(MARKER_SIZE)


def overlay(root_path, series, prefix, xtitle, out_path, caption,
            logy=False, normalize=False, title=""):
    """Overlay the named histograms from one ROOT file onto a canvas, using
    the standardized plot style: filled-circle markers with vertical
    error bars, framed legend (top-right), y-range that covers every
    series with 10 % padding."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    f = ROOT.TFile.Open(root_path)
    if not f or f.IsZombie():
        print("  ! cannot open %s — skipping" % root_path)
        return None

    # Pass 1 — load + style each histogram.
    prepared = []                        # [(h, label)]
    for base, label, colexpr in series:
        h = f.Get(prefix + base)
        if not h:
            continue
        h = h.Clone(prefix + base + "_c")
        h.SetDirectory(0)
        if normalize and h.Integral() > 0:
            h.Scale(1.0 / h.Integral())
        _style_marker(h, root_color(colexpr, ROOT))
        prepared.append((h, label))

    if not prepared:
        print("  ! %s: none of the expected histograms were found" % root_path)
        f.Close()
        return None

    # Pass 2 — set y-range on the first hist (governs the SAME-axis draw),
    # then draw everything as points with error bars.
    canvas = ROOT.TCanvas("c_" + os.path.basename(out_path), title, 900, 680)
    if logy:
        canvas.SetLogy()

    ymin, ymax = _yrange([p[0] for p in prepared], logy)
    prepared[0][0].SetMinimum(ymin)
    prepared[0][0].SetMaximum(ymax)
    _style_axes(prepared[0][0], xtitle,
                "normalized" if normalize else "counts", title)

    legend = ROOT.TLegend(0.62, 0.65, 0.88, 0.88)
    _legend_style(legend, ROOT)

    for i, (h, label) in enumerate(prepared):
        h.Draw("PE" if i == 0 else "PE SAME")
        legend.AddEntry(h, label, "pe")
    legend.Draw()

    canvas.SaveAs(out_path)
    f.Close()
    print("  wrote %s" % out_path)
    return caption


def overlay_fractions(root_path, series, prefix, divisor_base,
                      xtitle, out_path, caption):
    """Plot N_class / N_divisor per bin for each series entry, showing the
    LOCAL class composition.  Standardized style: points with error bars,
    framed legend, padded y-range."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    f = ROOT.TFile.Open(root_path)
    if not f or f.IsZombie():
        print("  ! cannot open %s" % root_path)
        return None
    den = f.Get(prefix + divisor_base)
    if not den:
        print("  ! %s: divisor %s not found" % (root_path, prefix + divisor_base))
        f.Close()
        return None
    den = den.Clone(prefix + divisor_base + "_den")
    den.SetDirectory(0)

    prepared = []
    for base, label, colexpr in series:
        if base == divisor_base:
            continue                          # don't divide all-by-all
        num = f.Get(prefix + base)
        if not num:
            continue
        ratio = num.Clone(prefix + base + "_ratio")
        ratio.SetDirectory(0)
        ratio.Divide(den)                     # bin-by-bin error propagation
        _style_marker(ratio, root_color(colexpr, ROOT))
        prepared.append((ratio, label))

    if not prepared:
        print("  ! %s: no classes to divide" % root_path)
        f.Close()
        return None

    canvas = ROOT.TCanvas("cf_" + os.path.basename(out_path), out_path, 900, 680)
    ymin, ymax = _yrange([p[0] for p in prepared], logy=False)
    prepared[0][0].SetMinimum(ymin)
    prepared[0][0].SetMaximum(ymax)
    _style_axes(prepared[0][0], xtitle, "fraction of all",
                "local class fraction")

    legend = ROOT.TLegend(0.62, 0.65, 0.88, 0.88)
    _legend_style(legend, ROOT)
    for i, (h, label) in enumerate(prepared):
        h.Draw("PE" if i == 0 else "PE SAME")
        legend.AddEntry(h, label, "pe")
    legend.Draw()

    canvas.SaveAs(out_path)
    f.Close()
    print("  wrote %s" % out_path)
    return caption


def single_histogram(root_path, histname, xtitle, out_path, caption, logy=False):
    """Draw one histogram (no overlay) in the standardized style."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    f = ROOT.TFile.Open(root_path)
    if not f or f.IsZombie():
        print("  ! cannot open %s" % root_path)
        return None
    h = f.Get(histname)
    if not h:
        print("  ! %s: histogram '%s' not found" % (root_path, histname))
        f.Close()
        return None
    h = h.Clone(histname + "_c"); h.SetDirectory(0)
    _style_marker(h, root_color("kAzure+1", ROOT))

    canvas = ROOT.TCanvas("cs_" + os.path.basename(out_path), out_path, 900, 680)
    if logy: canvas.SetLogy()
    ymin, ymax = _yrange([h], logy)
    h.SetMinimum(ymin); h.SetMaximum(ymax)
    _style_axes(h, xtitle, "entries")
    h.Draw("PE")

    canvas.SaveAs(out_path)
    f.Close()
    print("  wrote %s" % out_path)
    return caption


def overlay_ladder(rung_files, histname, xtitle, out_path, caption,
                   logy=False, normalize=True):
    """Overlay one histogram across the ladder rungs (one ROOT file each)
    in the standardized plot style."""
    import ROOT
    ROOT.gROOT.SetBatch(True)
    ROOT.gStyle.SetOptStat(0)

    prepared = []
    for i, (label, path) in enumerate(rung_files):
        f = ROOT.TFile.Open(path)
        if not f or f.IsZombie():
            print("  ! cannot open rung file %s" % path)
            continue
        h = f.Get(histname)
        if not h:
            print("  ! %s: histogram '%s' not found" % (path, histname))
            f.Close()
            continue
        h = h.Clone("%s_rung%d" % (histname, i))
        h.SetDirectory(0)
        f.Close()
        if normalize and h.Integral() > 0:
            h.Scale(1.0 / h.Integral())
        _style_marker(h, root_color(LADDER_COLOURS[i % len(LADDER_COLOURS)], ROOT))
        prepared.append((h, label))

    if not prepared:
        print("  ! ladder: no rung produced histogram '%s'" % histname)
        return None

    canvas = ROOT.TCanvas("cl_" + os.path.basename(out_path), histname, 900, 680)
    if logy: canvas.SetLogy()
    ymin, ymax = _yrange([p[0] for p in prepared], logy)
    prepared[0][0].SetMinimum(ymin)
    prepared[0][0].SetMaximum(ymax)
    _style_axes(prepared[0][0], xtitle,
                "normalized" if normalize else "counts",
                histname + " across the mechanism ladder")

    legend = ROOT.TLegend(0.62, 0.65, 0.88, 0.88)
    _legend_style(legend, ROOT)
    for i, (h, label) in enumerate(prepared):
        h.Draw("PE" if i == 0 else "PE SAME")
        legend.AddEntry(h, label, "pe")
    legend.Draw()

    canvas.SaveAs(out_path)
    print("  wrote %s" % out_path)
    return caption


def discover_rungs(ladder_dir):
    """Return [(rung-label, root-path), ...] in ladder order.

    Prefers the column order in ladder-comparison.csv; falls back to a
    sorted glob of *.root in the directory."""
    csv_path = os.path.join(ladder_dir, "ladder-comparison.csv")
    rungs = []
    if os.path.exists(csv_path):
        with open(csv_path) as fh:
            header = next(csv.reader(fh))
        # header: group, observable, <rung1>, <rung2>, ...
        for name in header[2:]:
            tag = name.replace("+", "_").replace(" ", "_")
            path = os.path.join(ladder_dir, tag + ".root")
            if os.path.exists(path):
                rungs.append((name, path))
    if not rungs:
        for path in sorted(glob.glob(os.path.join(ladder_dir, "*.root"))):
            label = os.path.splitext(os.path.basename(path))[0]
            rungs.append((label, path))
    return rungs


def main():
    ap = argparse.ArgumentParser(
        description="Overlay plots for provenance-study / mechanism-ladder "
                    "output.")
    ap.add_argument("--root", metavar="FILE",
                    help="a single provenance-study .root file")
    ap.add_argument("--ladder", metavar="DIR",
                    help="a cap-mechanism-ladder output directory")
    ap.add_argument("--outdir",
                    default=os.path.join(REPO, "provenance", "plots"),
                    help="directory for the figures (default provenance/plots/)")
    ap.add_argument("--format", default="pdf", choices=["pdf", "png", "svg"],
                    help="figure file format (default pdf)")
    ap.add_argument("--normalize", action="store_true",
                    help="normalize every histogram to unit integral")
    args = ap.parse_args()

    if not args.root and not args.ladder:
        ap.error("give --root FILE and/or --ladder DIR")

    os.makedirs(args.outdir, exist_ok=True)
    manifest = []   # (filename, caption)

    print("cap-provenance-plot — figures -> %s" % args.outdir)

    # ---- single-run decomposition figures -------------------------------
    if args.root:
        if not os.path.exists(args.root):
            sys.exit("ROOT file not found: " + args.root)
        print("single run: %s" % args.root)
        for name, prefix, series, xtitle, logy, norm, caption in FIGURES:
            out = os.path.join(args.outdir, name + "." + args.format)
            cap = overlay(args.root, series, prefix, xtitle, out, caption,
                          logy=logy, normalize=(args.normalize or norm))
            if cap:
                manifest.append((os.path.basename(out), cap))

        # ---- single-histogram figures (e.g. n_parton_ancestors) ----------
        for name, hist, xtitle, logy, caption in SINGLE_FIGURES:
            out = os.path.join(args.outdir, name + "." + args.format)
            cap = single_histogram(args.root, hist, xtitle, out, caption,
                                   logy=logy)
            if cap:
                manifest.append((os.path.basename(out), cap))

        # ---- fraction-per-bin figures (local class composition) ----------
        for name, prefix, series, xtitle, divisor, caption in FRACTION_FIGURES:
            out = os.path.join(args.outdir, name + "." + args.format)
            cap = overlay_fractions(args.root, series, prefix, divisor,
                                    xtitle, out, caption)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- mechanism-ladder comparison figures ----------------------------
    if args.ladder:
        if not os.path.isdir(args.ladder):
            sys.exit("ladder directory not found: " + args.ladder)
        rungs = discover_rungs(args.ladder)
        if not rungs:
            sys.exit("no rung .root files found in " + args.ladder)
        print("ladder: %d rung(s) — %s"
              % (len(rungs), ", ".join(r[0] for r in rungs)))
        for histname, xtitle, logy, caption in LADDER_HISTS:
            out = os.path.join(args.outdir, "ladder_" + histname + "."
                               + args.format)
            cap = overlay_ladder(rungs, histname, xtitle, out, caption,
                                 logy=logy, normalize=True)
            if cap:
                manifest.append((os.path.basename(out), cap))

    # ---- manifest for the report-builder --------------------------------
    man_path = os.path.join(args.outdir, "figures.manifest")
    with open(man_path, "w") as fh:
        for fname, caption in manifest:
            fh.write("%s | %s\n" % (fname, caption))
    print("\nwrote %d figure(s); manifest -> %s" % (len(manifest), man_path))


if __name__ == "__main__":
    main()
