#!/usr/bin/env python3
"""
cap-mechanism-ladder  —  Engine 1 of the parton-tracking feature.

Runs `provenance-study` across a *ladder* of Pythia 8 configurations,
each switching on one more mechanism, and tabulates how the provenance
breakdown shifts as that mechanism is added.

The default ladder is the four-rung sweep:

    shower  ->  shower+MPI  ->  shower+MPI+CR  ->  shower+MPI+CR+rope

so you can read, in one table, what MPI / colour-reconnection / rope
hadronization each do to the fraction of pions that are primary vs
resonance feed-down, and to the ancestry breakdown of the pair
correlation.

Modular by design: both the mechanism catalogue (MECHANISMS) and the
ladder (DEFAULT_LADDER) are plain data — edit them here, or pass your
own ladder file with --ladder.  The tool touches no C++; it only drives
the already-built bin/provenance-study and parses its text summary.

Usage:
    ./cap-mechanism-ladder --events 20000 --species 211
    ./cap-mechanism-ladder --ladder my-ladder.txt --dry-run
"""
from __future__ import annotations

import argparse
import concurrent.futures
import os
import re
import subprocess
import sys
import time

# ---------------------------------------------------------------------------
#  Mechanism catalogue:  name -> (lines to switch it ON, lines to switch OFF).
#
#  Every rung's .cmnd sets EVERY mechanism explicitly on or off, so a rung is
#  fully reproducible and never silently inherits a Pythia default.
#
#  These are sensible starting points — edit freely.  Rope hadronization in
#  particular is involved: the lines below are the minimal Ropewalk setup and
#  may need tuning for your Pythia version.
# ---------------------------------------------------------------------------
MECHANISMS = {
    "ISR":  (["PartonLevel:ISR = on"],
             ["PartonLevel:ISR = off"]),
    "FSR":  (["PartonLevel:FSR = on"],
             ["PartonLevel:FSR = off"]),
    "MPI":  (["PartonLevel:MPI = on"],
             ["PartonLevel:MPI = off"]),
    "CR":   (["ColourReconnection:reconnect = on"],
             ["ColourReconnection:reconnect = off"]),
    "rope": (["PartonVertex:setVertex = on",
              "Fragmentation:setVertices = on",
              "Ropewalk:RopeHadronization = on",
              "Ropewalk:doShoving = on",
              "Ropewalk:doFlavour = on"],
             ["Ropewalk:RopeHadronization = off"]),
}

# Ordered ladder: (rung name, mechanisms enabled at that rung).
DEFAULT_LADDER = [
    ("shower",             ["ISR", "FSR"]),
    ("shower+MPI",         ["ISR", "FSR", "MPI"]),
    ("shower+MPI+CR",      ["ISR", "FSR", "MPI", "CR"]),
    ("shower+MPI+CR+rope", ["ISR", "FSR", "MPI", "CR", "rope"]),
]

# Observables pulled from each run's summary, grouped for the report.
REPORT_GROUPS = [
    ("origin", ["Primary", "FromResonance", "FromWeakDecay"]),
    ("parton", ["LightQuark", "Strange", "Charm", "Bottom", "Gluon"]),
    ("pair",   ["SameResonance", "SameWeakParent", "SharedParton", "Unrelated"]),
]


# ---------------------------------------------------------------------------
def write_cmnd(path, enabled, extra_lines=None):
    """Write the Pythia command file for a rung — every known mechanism set
    explicitly on or off.  `extra_lines` (if given) is appended verbatim so
    callers can splice in tune lines, decay disablers, or a global cτ cut
    without re-implementing the mechanism dispatch.  The extras come AFTER
    the mechanism block, so a custom 'PartonLevel:MPI = off' in the extras
    can override a rung that would normally enable MPI."""
    lines = ["! generated by cap-mechanism-ladder",
             "! enabled: " + (" ".join(enabled) if enabled else "(none)")]
    for mech, (on, off) in MECHANISMS.items():
        lines += (on if mech in enabled else off)
    if extra_lines:
        lines.append("! ---- extra lines spliced in via --extra-cmnd ----")
        lines += [str(ln).rstrip() for ln in extra_lines if str(ln).strip()]
    with open(path, "w") as fh:
        fh.write("\n".join(lines) + "\n")


def parse_summary(path):
    """Pull {class-name: percentage} out of a provenance-study .txt summary.
    Class names are unique across the origin / parton / pair sections, so a
    single flat dict is unambiguous."""
    pct = {}
    rx = re.compile(r"^\s+([A-Za-z]\w*)\s+(\d+)\s+([\d.]+)\s*%")
    with open(path) as fh:
        for line in fh:
            m = rx.match(line)
            if m:
                pct[m.group(1)] = float(m.group(3))
    return pct


def load_ladder(path):
    """Load a custom ladder file.  Each non-comment line:
        rung-name: MECH1 MECH2 ...
    """
    ladder = []
    with open(path) as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if ":" not in line:
                sys.exit("ladder file: expected 'name: mech ...' — got: " + line)
            name, rest = line.split(":", 1)
            mechs = rest.split()
            for m in mechs:
                if m not in MECHANISMS:
                    sys.exit("ladder file: unknown mechanism '%s' "
                             "(known: %s)" % (m, ", ".join(MECHANISMS)))
            ladder.append((name.strip(), mechs))
    if not ladder:
        sys.exit("ladder file is empty: " + path)
    return ladder


def print_table(ladder, results, meta):
    """Render the across-rung comparison table; return it as text."""
    rungs = [n for n, _ in ladder]
    colw = max(13, max(len(r) for r in rungs) + 2)
    out = []
    out.append("=" * (28 + colw * (len(rungs) + 1)))
    out.append("  CAP mechanism ladder — provenance breakdown")
    out.append("  " + meta)
    out.append("=" * (28 + colw * (len(rungs) + 1)))
    header = "  {:<26}".format("observable [%]")
    for r in rungs:
        header += "{:>{w}}".format(r, w=colw)
    header += "{:>{w}}".format("d(last-1st)", w=colw)
    out.append(header)
    out.append("  " + "-" * (26 + colw * (len(rungs) + 1)))
    for group, rows in REPORT_GROUPS:
        for cls in rows:
            label = "  {:<26}".format(group + ": " + cls)
            vals = [results.get(r, {}).get(cls) for r in rungs]
            cells = ""
            for v in vals:
                cells += "{:>{w}}".format("-" if v is None else "%.2f" % v,
                                          w=colw)
            first, last = vals[0], vals[-1]
            if first is None or last is None:
                delta = "-"
            else:
                delta = "%+.2f" % (last - first)
            cells += "{:>{w}}".format(delta, w=colw)
            out.append(label + cells)
        out.append("")
    text = "\n".join(out)
    print(text)
    return text


def write_csv(path, ladder, results):
    rungs = [n for n, _ in ladder]
    with open(path, "w") as fh:
        fh.write("group,observable," + ",".join(rungs) + "\n")
        for group, rows in REPORT_GROUPS:
            for cls in rows:
                cells = []
                for r in rungs:
                    v = results.get(r, {}).get(cls)
                    cells.append("" if v is None else "%.4f" % v)
                fh.write("%s,%s,%s\n" % (group, cls, ",".join(cells)))


# ---------------------------------------------------------------------------
def main():
    here = os.path.dirname(os.path.abspath(__file__))

    ap = argparse.ArgumentParser(
        description="Run provenance-study across a ladder of Pythia "
                    "mechanism configurations.")
    ap.add_argument("-n", "--events",  type=int, default=10000,
                    help="events per rung (default 10000)")
    ap.add_argument("-s", "--species", type=str, default="211",
                    help="|pdg| of the species to study (default 211), OR "
                         "a comma-separated list (e.g. 211,321,2212) to "
                         "run single + pair analysis across every species "
                         "combination.  Forwarded verbatim to provenance-study.")
    ap.add_argument("--ecm",   type=float, default=13000.0,
                    help="pp centre-of-mass energy in GeV (default 13000)")
    ap.add_argument("--seed",  type=int, default=12345,
                    help="Pythia seed, shared across rungs (default 12345)")
    ap.add_argument("--ladder", metavar="FILE",
                    help="custom ladder file ('name: MECH ...' per line)")
    ap.add_argument("--outdir",
                    default=os.path.join(here, "provenance", "ladder"),
                    help="directory for .cmnd / .root outputs "
                         "(default provenance/ladder/)")
    ap.add_argument("--study",  default=os.path.join(here, "bin", "provenance-study"),
                    help="path to the provenance-study binary")
    ap.add_argument("--xmldoc", default="",
                    help="Pythia xmldoc directory (passed through)")
    ap.add_argument("--dry-run", action="store_true",
                    help="only generate the .cmnd files; do not run")
    ap.add_argument("--extra-cmnd", metavar="FILE",
                    help="path to a Pythia .cmnd file whose lines will be "
                         "appended to EVERY rung's generated .cmnd before "
                         "provenance-study runs it.  Use this to splice in "
                         "tune presets, decay disablers (e.g. "
                         "'310:mayDecay = false'), a global cτ cut, or any "
                         "other readString settings the GUI / caller wants "
                         "applied across the whole ladder.")
    # Acceptance window — forwarded straight to provenance-study so every
    # rung sees the same kinematic cuts.  Defaults are wide-open, matching
    # provenance-study's own defaults.
    ap.add_argument("--pt-min",  type=float, default=None,
                    help="reject pions with pT below this value [GeV]")
    ap.add_argument("--pt-max",  type=float, default=None,
                    help="reject pions with pT above this value [GeV]")
    ap.add_argument("--eta-min", type=float, default=None,
                    help="reject pions with eta below this value")
    ap.add_argument("--eta-max", type=float, default=None,
                    help="reject pions with eta above this value")
    ap.add_argument("--mult-low",  type=int, default=None,
                    help="LowMult cut (event multiplicity boundary)")
    ap.add_argument("--mult-high", type=int, default=None,
                    help="HighMult cut (event multiplicity boundary)")
    ap.add_argument("--sphero-low",  type=float, default=None,
                    help="JetLike / MidShape cut on transverse spherocity S0")
    ap.add_argument("--sphero-high", type=float, default=None,
                    help="MidShape / Isotropic cut on transverse spherocity S0")
    ap.add_argument("--validate-graph", action="store_true",
                    help="forward --validate-graph to every rung")
    ap.add_argument("--entropy", action="store_true",
                    help="forward --entropy (entropy / information "
                         "observables) to every rung")
    ap.add_argument("--systems", action="store_true",
                    help="forward --systems (fragmentation-system "
                         "observables) to every rung")
    ap.add_argument("-j", "--jobs", type=int, default=1,
                    help="number of rungs to run in parallel (default 1 = "
                         "sequential, current behaviour).  Each rung is an "
                         "independent Pythia job, so wall-clock scales "
                         "almost linearly up to your core count.  Pass 0 "
                         "or a negative number to use min(rungs, nproc).")
    ap.add_argument("--seed-per-rung", action="store_true",
                    help="give each rung a distinct seed (--seed + rung "
                         "index).  Default is a single shared seed so that "
                         "Pythia draws the same event sequence for every "
                         "rung — useful when you want the mechanism "
                         "comparison to be 'same events, different physics'.")
    args = ap.parse_args()

    ladder = load_ladder(args.ladder) if args.ladder else DEFAULT_LADDER

    if not args.dry_run and not os.path.exists(args.study):
        sys.exit("provenance-study not found at: %s\n"
                 "Build the branch first ( ./install ), or pass --study PATH."
                 % args.study)

    os.makedirs(args.outdir, exist_ok=True)
    meta = "events=%d  species=%s  ecm=%g  seed=%d  rungs=%d" % (
        args.events, args.species or "all", args.ecm, args.seed, len(ladder))
    print("cap-mechanism-ladder — Engine 1 (parton-tracking)")
    print("  " + meta + "\n")

    # ---- decide concurrency ------------------------------------------------
    # jobs <= 0 means "auto" — saturate without going past min(rungs, nproc).
    requested = args.jobs
    if requested <= 0:
        requested = min(len(ladder), os.cpu_count() or 1)
    nJobs = max(1, min(requested, len(ladder)))

    # Read extras once if supplied; they get spliced into every rung's .cmnd.
    extra_lines = []
    if args.extra_cmnd:
        if not os.path.exists(args.extra_cmnd):
            sys.exit("--extra-cmnd file not found: " + args.extra_cmnd)
        with open(args.extra_cmnd) as fh:
            extra_lines = [ln.rstrip() for ln in fh
                           if ln.strip() and not ln.lstrip().startswith("!")
                           and not ln.lstrip().startswith("#")]

    # ---- build the per-rung work list --------------------------------------
    # Done once up front so .cmnd files exist whether we're in dry-run mode
    # or about to dispatch.  The work tuples carry every input the worker
    # needs — keep the dispatch loop branch-free.
    work = []
    for idx, (name, mechs) in enumerate(ladder):
        tag  = name.replace("+", "_").replace(" ", "_")
        cmnd = os.path.join(args.outdir, tag + ".cmnd")
        root = os.path.join(args.outdir, tag + ".root")
        write_cmnd(cmnd, mechs, extra_lines=extra_lines)
        # Per-rung seed lets every rung have its own RNG stream; default
        # keeps the historical "shared seed" behaviour (same events,
        # different physics).
        rung_seed = args.seed + idx if args.seed_per_rung else args.seed
        cmd = [args.study,
               "--events",  str(args.events),
               "--species", str(args.species),       # may be e.g. "211,321"
               "--ecm",     str(args.ecm),
               "--seed",    str(rung_seed),
               "--config",  cmnd,
               "--out",     root]
        if args.xmldoc:           cmd += ["--xmldoc",   args.xmldoc]
        if args.pt_min  is not None: cmd += ["--pt-min",  str(args.pt_min)]
        if args.pt_max  is not None: cmd += ["--pt-max",  str(args.pt_max)]
        if args.eta_min is not None: cmd += ["--eta-min", str(args.eta_min)]
        if args.eta_max is not None: cmd += ["--eta-max", str(args.eta_max)]
        if args.mult_low  is not None:
            cmd += ["--mult-low",  str(args.mult_low)]
        if args.mult_high is not None:
            cmd += ["--mult-high", str(args.mult_high)]
        if args.sphero_low  is not None:
            cmd += ["--sphero-low",  str(args.sphero_low)]
        if args.sphero_high is not None:
            cmd += ["--sphero-high", str(args.sphero_high)]
        if args.validate_graph:   cmd += ["--validate-graph"]
        if args.entropy:          cmd += ["--entropy"]
        if args.systems:          cmd += ["--systems"]
        work.append((name, mechs, cmnd, root, cmd, rung_seed))
        print("  rung '%s'  enabled: %s" % (name, " ".join(mechs) or "(none)"))
        print("    config -> %s" % cmnd)

    if args.dry_run:
        print("\n  dry run — %d .cmnd file(s) written to %s"
              % (len(ladder), args.outdir))
        return

    print("\n  dispatching %d rung(s) with --jobs %d  (%s mode)" %
          (len(work), nJobs,
           "parallel" if nJobs > 1 else "sequential"))

    # ---- run rungs ---------------------------------------------------------
    def run_one(item):
        """Execute one rung.  In sequential mode the binary's stdout streams
        live; in parallel mode it is captured and replayed in a labeled
        block after the rung finishes (so multiple rungs' output doesn't
        interleave)."""
        name, mechs, cmnd, root, cmd, rung_seed = item
        t0 = time.time()
        if nJobs == 1:
            # Streaming output — same UX as before.
            print("    rung '%s' running provenance-study "
                  "(seed=%d) ..." % (name, rung_seed))
            try:
                subprocess.run(cmd, check=True)
                rc = 0
                captured = ""
            except subprocess.CalledProcessError as exc:
                rc = exc.returncode
                captured = ""
        else:
            # Captured output — printed in a tidy block on completion.
            proc = subprocess.run(cmd, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT, text=True)
            rc = proc.returncode
            captured = proc.stdout or ""
        dt = time.time() - t0
        return (name, root, cmd, rc, captured, dt, rung_seed)

    results = {}
    failures = []

    if nJobs == 1:
        # Sequential — preserves the original UX exactly.
        for item in work:
            name, root, _, rc, captured, dt, seed = run_one(item)
            print("    rung '%s' finished in %.1f s  (seed=%d, exit=%d)"
                  % (name, dt, seed, rc))
            if rc != 0:
                failures.append((name, rc, captured))
                continue
            summary = root + ".txt"
            if not os.path.exists(summary):
                failures.append((name, -1, "summary not found: " + summary))
                continue
            results[name] = parse_summary(summary)
    else:
        # Parallel — thread pool is fine: each worker is blocked inside
        # subprocess.run on a child Pythia process, no Python GIL contention.
        t0 = time.time()
        with concurrent.futures.ThreadPoolExecutor(max_workers=nJobs) as pool:
            futures = {pool.submit(run_one, w): w[0] for w in work}
            for fut in concurrent.futures.as_completed(futures):
                name, root, _, rc, captured, dt, seed = fut.result()
                # Header + captured stdout — block-printed atomically.
                print("\n  ---- rung '%s' (seed=%d) finished in %.1f s, "
                      "exit=%d ----" % (name, seed, dt, rc))
                if captured.strip():
                    for ln in captured.rstrip().splitlines():
                        print("    [%s] %s" % (name, ln))
                if rc != 0:
                    failures.append((name, rc, captured))
                    continue
                summary = root + ".txt"
                if not os.path.exists(summary):
                    failures.append((name, -1, "summary not found: " + summary))
                    continue
                results[name] = parse_summary(summary)
        print("\n  all rungs done in %.1f s wall-clock "
              "(speedup vs sequential ~= sum / wall)." % (time.time() - t0))

    if failures:
        print("\n  FAILED rungs:")
        for name, rc, msg in failures:
            print("    - %s  exit=%d" % (name, rc))
            if msg:
                # last 20 lines of captured output is usually enough to debug.
                tail = msg.rstrip().splitlines()[-20:]
                for ln in tail:
                    print("        [%s] %s" % (name, ln))
        sys.exit("aborting after %d failed rung(s)" % len(failures))

    print()
    text = print_table(ladder, results, meta)

    txt_path = os.path.join(args.outdir, "ladder-comparison.txt")
    csv_path = os.path.join(args.outdir, "ladder-comparison.csv")
    with open(txt_path, "w") as fh:
        fh.write(text + "\n")
    write_csv(csv_path, ladder, results)
    print("  comparison written to:")
    print("    " + txt_path)
    print("    " + csv_path + "   (one row per observable, one column per rung)")


if __name__ == "__main__":
    main()
