#!/usr/bin/env python3
"""
cap-mechanism-ladder  —  Engine 1 of the parton-tracking feature.

Runs `provenance-study` across a *ladder* of Pythia 8 configurations,
each switching on one more mechanism, and tabulates how the provenance
breakdown shifts as that mechanism is added.

The default ladder is the four-rung sweep:

    shower  ->  shower+MPI  ->  shower+MPI+CR  ->  shower+MPI+CR+rope

so you can read, in one table, what MPI / colour-reconnection / rope
hadronization each do to the fraction of pions that are primary vs
resonance feed-down, and to the ancestry breakdown of the pair
correlation.

Modular by design: both the mechanism catalogue (MECHANISMS) and the
ladder (DEFAULT_LADDER) are plain data — edit them here, or pass your
own ladder file with --ladder.  The tool touches no C++; it only drives
the already-built bin/provenance-study and parses its text summary.

Usage:
    ./cap-mechanism-ladder --events 20000 --species 211
    ./cap-mechanism-ladder --ladder my-ladder.txt --dry-run
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys

# ---------------------------------------------------------------------------
#  Mechanism catalogue:  name -> (lines to switch it ON, lines to switch OFF).
#
#  Every rung's .cmnd sets EVERY mechanism explicitly on or off, so a rung is
#  fully reproducible and never silently inherits a Pythia default.
#
#  These are sensible starting points — edit freely.  Rope hadronization in
#  particular is involved: the lines below are the minimal Ropewalk setup and
#  may need tuning for your Pythia version.
# ---------------------------------------------------------------------------
MECHANISMS = {
    "ISR":  (["PartonLevel:ISR = on"],
             ["PartonLevel:ISR = off"]),
    "FSR":  (["PartonLevel:FSR = on"],
             ["PartonLevel:FSR = off"]),
    "MPI":  (["PartonLevel:MPI = on"],
             ["PartonLevel:MPI = off"]),
    "CR":   (["ColourReconnection:reconnect = on"],
             ["ColourReconnection:reconnect = off"]),
    "rope": (["PartonVertex:setVertex = on",
              "Fragmentation:setVertices = on",
              "Ropewalk:RopeHadronization = on",
              "Ropewalk:doShoving = on",
              "Ropewalk:doFlavour = on"],
             ["Ropewalk:RopeHadronization = off"]),
}

# Ordered ladder: (rung name, mechanisms enabled at that rung).
DEFAULT_LADDER = [
    ("shower",             ["ISR", "FSR"]),
    ("shower+MPI",         ["ISR", "FSR", "MPI"]),
    ("shower+MPI+CR",      ["ISR", "FSR", "MPI", "CR"]),
    ("shower+MPI+CR+rope", ["ISR", "FSR", "MPI", "CR", "rope"]),
]

# Observables pulled from each run's summary, grouped for the report.
REPORT_GROUPS = [
    ("origin", ["Primary", "FromResonance", "FromWeakDecay"]),
    ("parton", ["LightQuark", "Strange", "Charm", "Bottom", "Gluon"]),
    ("pair",   ["SameResonance", "SameWeakParent", "SharedParton", "Unrelated"]),
]


# ---------------------------------------------------------------------------
def write_cmnd(path, enabled):
    """Write the Pythia command file for a rung — every known mechanism set
    explicitly on or off."""
    lines = ["! generated by cap-mechanism-ladder",
             "! enabled: " + (" ".join(enabled) if enabled else "(none)")]
    for mech, (on, off) in MECHANISMS.items():
        lines += (on if mech in enabled else off)
    with open(path, "w") as fh:
        fh.write("\n".join(lines) + "\n")


def parse_summary(path):
    """Pull {class-name: percentage} out of a provenance-study .txt summary.
    Class names are unique across the origin / parton / pair sections, so a
    single flat dict is unambiguous."""
    pct = {}
    rx = re.compile(r"^\s+([A-Za-z]\w*)\s+(\d+)\s+([\d.]+)\s*%")
    with open(path) as fh:
        for line in fh:
            m = rx.match(line)
            if m:
                pct[m.group(1)] = float(m.group(3))
    return pct


def load_ladder(path):
    """Load a custom ladder file.  Each non-comment line:
        rung-name: MECH1 MECH2 ...
    """
    ladder = []
    with open(path) as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if ":" not in line:
                sys.exit("ladder file: expected 'name: mech ...' — got: " + line)
            name, rest = line.split(":", 1)
            mechs = rest.split()
            for m in mechs:
                if m not in MECHANISMS:
                    sys.exit("ladder file: unknown mechanism '%s' "
                             "(known: %s)" % (m, ", ".join(MECHANISMS)))
            ladder.append((name.strip(), mechs))
    if not ladder:
        sys.exit("ladder file is empty: " + path)
    return ladder


def print_table(ladder, results, meta):
    """Render the across-rung comparison table; return it as text."""
    rungs = [n for n, _ in ladder]
    colw = max(13, max(len(r) for r in rungs) + 2)
    out = []
    out.append("=" * (28 + colw * (len(rungs) + 1)))
    out.append("  CAP mechanism ladder — provenance breakdown")
    out.append("  " + meta)
    out.append("=" * (28 + colw * (len(rungs) + 1)))
    header = "  {:<26}".format("observable [%]")
    for r in rungs:
        header += "{:>{w}}".format(r, w=colw)
    header += "{:>{w}}".format("d(last-1st)", w=colw)
    out.append(header)
    out.append("  " + "-" * (26 + colw * (len(rungs) + 1)))
    for group, rows in REPORT_GROUPS:
        for cls in rows:
            label = "  {:<26}".format(group + ": " + cls)
            vals = [results.get(r, {}).get(cls) for r in rungs]
            cells = ""
            for v in vals:
                cells += "{:>{w}}".format("-" if v is None else "%.2f" % v,
                                          w=colw)
            first, last = vals[0], vals[-1]
            if first is None or last is None:
                delta = "-"
            else:
                delta = "%+.2f" % (last - first)
            cells += "{:>{w}}".format(delta, w=colw)
            out.append(label + cells)
        out.append("")
    text = "\n".join(out)
    print(text)
    return text


def write_csv(path, ladder, results):
    rungs = [n for n, _ in ladder]
    with open(path, "w") as fh:
        fh.write("group,observable," + ",".join(rungs) + "\n")
        for group, rows in REPORT_GROUPS:
            for cls in rows:
                cells = []
                for r in rungs:
                    v = results.get(r, {}).get(cls)
                    cells.append("" if v is None else "%.4f" % v)
                fh.write("%s,%s,%s\n" % (group, cls, ",".join(cells)))


# ---------------------------------------------------------------------------
def main():
    here = os.path.dirname(os.path.abspath(__file__))

    ap = argparse.ArgumentParser(
        description="Run provenance-study across a ladder of Pythia "
                    "mechanism configurations.")
    ap.add_argument("-n", "--events",  type=int, default=10000,
                    help="events per rung (default 10000)")
    ap.add_argument("-s", "--species", type=int, default=211,
                    help="|pdg| to study, 0 = all final hadrons (default 211)")
    ap.add_argument("--ecm",   type=float, default=13000.0,
                    help="pp centre-of-mass energy in GeV (default 13000)")
    ap.add_argument("--seed",  type=int, default=12345,
                    help="Pythia seed, shared across rungs (default 12345)")
    ap.add_argument("--ladder", metavar="FILE",
                    help="custom ladder file ('name: MECH ...' per line)")
    ap.add_argument("--outdir", default=os.path.join(here, "ladder-runs"),
                    help="directory for .cmnd / .root outputs (default ladder-runs/)")
    ap.add_argument("--study",  default=os.path.join(here, "bin", "provenance-study"),
                    help="path to the provenance-study binary")
    ap.add_argument("--xmldoc", default="",
                    help="Pythia xmldoc directory (passed through)")
    ap.add_argument("--dry-run", action="store_true",
                    help="only generate the .cmnd files; do not run")
    args = ap.parse_args()

    ladder = load_ladder(args.ladder) if args.ladder else DEFAULT_LADDER

    if not args.dry_run and not os.path.exists(args.study):
        sys.exit("provenance-study not found at: %s\n"
                 "Build the branch first ( ./install ), or pass --study PATH."
                 % args.study)

    os.makedirs(args.outdir, exist_ok=True)
    meta = "events=%d  species=%s  ecm=%g  seed=%d  rungs=%d" % (
        args.events, args.species or "all", args.ecm, args.seed, len(ladder))
    print("cap-mechanism-ladder — Engine 1 (parton-tracking)")
    print("  " + meta + "\n")

    results = {}
    for name, mechs in ladder:
        tag  = name.replace("+", "_").replace(" ", "_")
        cmnd = os.path.join(args.outdir, tag + ".cmnd")
        root = os.path.join(args.outdir, tag + ".root")
        write_cmnd(cmnd, mechs)
        print("  rung '%s'  enabled: %s" % (name, " ".join(mechs) or "(none)"))
        print("    config -> %s" % cmnd)
        if args.dry_run:
            continue
        cmd = [args.study,
               "--events",  str(args.events),
               "--species", str(args.species),
               "--ecm",     str(args.ecm),
               "--seed",    str(args.seed),
               "--config",  cmnd,
               "--out",     root]
        if args.xmldoc:
            cmd += ["--xmldoc", args.xmldoc]
        print("    running provenance-study ...")
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as exc:
            sys.exit("rung '%s' failed (provenance-study exit %d)"
                     % (name, exc.returncode))
        summary = root + ".txt"
        if not os.path.exists(summary):
            sys.exit("rung '%s': expected summary not found: %s"
                     % (name, summary))
        results[name] = parse_summary(summary)

    if args.dry_run:
        print("\n  dry run — %d .cmnd file(s) written to %s"
              % (len(ladder), args.outdir))
        return

    print()
    text = print_table(ladder, results, meta)

    txt_path = os.path.join(args.outdir, "ladder-comparison.txt")
    csv_path = os.path.join(args.outdir, "ladder-comparison.csv")
    with open(txt_path, "w") as fh:
        fh.write(text + "\n")
    write_csv(csv_path, ladder, results)
    print("  comparison written to:")
    print("    " + txt_path)
    print("    " + csv_path + "   (one row per observable, one column per rung)")


if __name__ == "__main__":
    main()
